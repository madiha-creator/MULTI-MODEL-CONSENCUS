# WebSocket server URL (backend team provides this)
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# AI Provider Keys (agent reasoning layer — /api/agents/decide)
# Without GROQ_API_KEY the dashboard runs fully; the Agent Consensus
# panel shows "NOT CONFIGURED" and skips LLM rounds (no calls, no cost).
# GROQ_API_KEY=gsk_...             # agent bus + arbiter (openai/gpt-oss-20b via Groq)
# ANTHROPIC_API_KEY=sk-ant-...     # reserved — adapter pattern, not yet wired
