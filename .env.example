# Multi-Modal Consensus Broker — environment configuration
# Copy to `.env` and adjust. `.env` is gitignored.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080
DRIFT_THRESHOLD=4.0

# ─── MongoDB (Data Persistence & Routing) ────────────────────────────────────
# Local Docker (default from docker-compose):
MONGODB_URI=mongodb://localhost:27017/consensus_broker
# MongoDB Atlas (production) — swap the line above for your cluster URI:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/consensus_broker?retryWrites=true&w=majority

# Connection pool sizing for high-throughput ingestion
MONGO_MAX_POOL=50
MONGO_MIN_POOL=5

# Buffered-writer tuning
MONGO_BATCH_SIZE=100          # flush readings once this many are buffered
MONGO_FLUSH_MS=1000           # ...or at least this often (ms)
MONGO_MAX_BUFFER=10000        # in-memory backpressure cap during DB outages

# Auto-expire raw telemetry readings after this many seconds (default 24h).
# Drift events are kept permanently regardless.
MONGO_READING_TTL_SECONDS=86400
